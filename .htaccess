# Serves the built Vite application on chammastore.com.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One host, one set of URLs.
    #
    # chammastore.com, www.chammastore.com and http:// all serve this same
    # application, and each answers 200 with the same content. A crawler reads
    # that as three copies of the shop competing with one another, and the
    # canonical tags cannot fix it because the duplicates disagree about which
    # one is canonical.
    #
    # This has to run *before* the SPA fallback below: that rule ends with [L],
    # so anything placed after it would never be reached.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !=chammastore.com [NC]
    RewriteRule ^ https://chammastore.com%{REQUEST_URI} [R=301,L]

    # The bare root is the French shop, permanently.
    #
    # / served index.html and let the SPA pick a locale from the browser's
    # language, so Googlebot (an en-US browser) landed on /en and the brand
    # result for "chamma store" rendered in English with the Arabic pages as
    # sub-results. Redirecting / to /fr here — before the SPA fallback, and
    # with a real 301 rather than a client-side rewrite — means the URL a
    # crawler sees for the shop's front door is always the French page, the
    # same one the canonical and hreflang tags call x-default. The SPA keeps
    # the same fallback for hosts that do not run this .htaccess (nginx).
    RewriteRule ^/?$ https://chammastore.com/fr [R=301,L]

    # The bundle is a single page app, but the SPA owns a known URL space, not
    # every URL: every storefront route lives under a locale prefix
    # (/{locale}/products/..., /{locale}/checkout, ...) and the admin panel
    # under /admin. Those prefixes fall back to index.html, so a refresh or a
    # shared link on a client-side route keeps working.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(fr|ar|en)(/|$) /index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin(/|$) /index.html [L]

    # Anything else that is not a file on disk does not exist, and says so with
    # a real 404 (the document it is served with is set by the ErrorDocument
    # below). Falling back to index.html with HTTP 200 for *every* URL was how
    # the shop accumulated soft 404s in Search Console: a deleted product or a
    # mistyped link was answered "page not found" with the success status. For
    # the URLs the SPA does own, the pages themselves answer for the dead
    # slugs — product and brand pages render the 404 view with a noindex meta
    # when the API says the resource is not there.
</IfModule>

# What a real 404 serves: still the bundle, so a human who follows a dead link
# lands in the shop (the SPA's LocaleRedirect takes it home) rather than on the
# host's bare error page — while a crawler reads the 404 status and drops the
# URL. A local path, not a full URL: an ErrorDocument given a URL answers 302,
# which would trade the hard 404 for a redirect.
ErrorDocument 404 /index.html

# Caching. Two kinds of file ship in this tree, and they need opposite
# policies.
#
# The build output under assets/ is content-hashed: the filename changes
# whenever the content does, so it can be cached for a year and marked
# immutable — the same policy nginx.conf applies in the Docker deployment.
# Without this block the shared host sent no policy at all, and every visit
# revalidated the whole bundle and every font subset.
#
# The files copied from public/ (the hero photographs, the logo, the bank
# slip, the favicon) are NOT hashed: they can change under their own name, so
# a week rather than a year — long enough to carry a browsing session, short
# enough that replacing one shows up the same week.
#
# index.html must never be cached, or a deploy would keep serving the
# previous bundle's filenames.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:js|mjs|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:jpe?g|png|svg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
