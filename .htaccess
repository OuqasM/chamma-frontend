# Serves the built Vite application on chammastore.com.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One host, one set of URLs.
    #
    # chammastore.com, www.chammastore.com and http:// all serve this same
    # application, and each answers 200 with the same content. A crawler reads
    # that as three copies of the shop competing with one another, and the
    # canonical tags cannot fix it because the duplicates disagree about which
    # one is canonical.
    #
    # This has to run *before* the SPA fallback below: that rule ends with [L],
    # so anything placed after it would never be reached.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !=chammastore.com [NC]
    RewriteRule ^ https://chammastore.com%{REQUEST_URI} [R=301,L]

    # The bundle is a single page app: React Router owns every path that is not
    # a file on disk, so a refresh or a shared link on /checkout or /product/...
    # has to return index.html instead of a 404. Without this rule the
    # storefront only works on the home page and breaks on every client side
    # navigation that is reloaded.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# Caching. Two kinds of file ship in this tree, and they need opposite
# policies.
#
# The build output under assets/ is content-hashed: the filename changes
# whenever the content does, so it can be cached for a year and marked
# immutable — the same policy nginx.conf applies in the Docker deployment.
# Without this block the shared host sent no policy at all, and every visit
# revalidated the whole bundle and every font subset.
#
# The files copied from public/ (the hero photographs, the logo, the bank
# slip, the favicon) are NOT hashed: they can change under their own name, so
# a week rather than a year — long enough to carry a browsing session, short
# enough that replacing one shows up the same week.
#
# index.html must never be cached, or a deploy would keep serving the
# previous bundle's filenames.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:js|mjs|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:jpe?g|png|svg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
