# Serves the built Vite application on chammastore.com.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # One host, one set of URLs.
    #
    # chammastore.com, www.chammastore.com and http:// all serve this same
    # application, and each answers 200 with the same content. A crawler reads
    # that as three copies of the shop competing with one another, and the
    # canonical tags cannot fix it because the duplicates disagree about which
    # one is canonical.
    #
    # This has to run *before* the SPA fallback below: that rule ends with [L],
    # so anything placed after it would never be reached.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !=chammastore.com [NC]
    RewriteRule ^ https://chammastore.com%{REQUEST_URI} [R=301,L]

    # The sitemap, served from the storefront's own host.
    #
    # The XML is generated by the API from live catalogue data, but Search
    # Console only accepts a sitemap on the host of the verified property. The
    # property here is chammastore.com while the API answers on
    # api.chammastore.com, so submitting the API's URL is refused by the very
    # screen meant to accept it. Proxying puts the same document on the right
    # host without freezing a copy, so the sitemap cannot go stale the next time
    # a product is added — which a committed file would.
    #
    # This has to sit above the SPA fallback below. That rule would otherwise
    # answer /sitemap.xml with index.html and a 200, which is worse than a 404:
    # a sitemap that returns HTML and looks successful.
    RewriteRule ^sitemap\.xml$ https://api.chammastore.com/api/sitemap.xml [P,L]

    # The bundle is a single page app: React Router owns every path that is not
    # a file on disk, so a refresh or a shared link on /checkout or /product/...
    # has to return index.html instead of a 404. Without this rule the
    # storefront only works on the home page and breaks on every client side
    # navigation that is reloaded.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# The built index.html points at content hashed filenames, so it must not be
# cached or a deploy would keep serving the previous bundle.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
