# Serves the built Vite application on chammastore.com.
#
# The bundle is a single page app: React Router owns every path that is not a
# file on disk, so a refresh or a shared link on /checkout or /product/... has
# to return index.html instead of a 404. Without this rule the storefront only
# works on the home page and breaks on every client side navigation that is
# reloaded.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# The built index.html points at content hashed filenames, so it must not be
# cached or a deploy would keep serving the previous bundle.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
